{
  # Global options; no admin API exposed externally.
  admin off
  # L4 app configuration.
  layer4 {
    :443 {
      @reality tls sni {{ reality_server_names[0] }}
      route @reality {
        proxy 127.0.0.1:{{ xray_reality_listen_port }}
      }
      # App-owned L7 web service via exact SNI (empty var => not rendered).
      # Only a matching SNI is diverted to the app inner Caddy on loopback;
      # everything else keeps falling through to the default Xray route below.
{% if caddy_l4_web_sni_host | default('') | length > 0 %}
      @web tls sni {{ caddy_l4_web_sni_host }}
      route @web {
        proxy {{ caddy_l4_web_upstream | default('127.0.0.1:8444') }}
      }
{% endif %}
{% for route in caddy_l4_extra_web_routes | default([]) %}
      @{{ route.name }} tls sni {{ route.sni_host }}
      route @{{ route.name }} {
        proxy {{ route.upstream }}
      }
{% endfor %}

      # Default: отправляем в Xray, чей Reality fallback на dest проксирует
      # не-Reality трафик на настоящий cover-SNI. Это даёт единое
      # индистингуишабл поведение для сторонних сканеров.
      route {
        proxy 127.0.0.1:{{ xray_reality_listen_port }}
      }
    }
  }
}
