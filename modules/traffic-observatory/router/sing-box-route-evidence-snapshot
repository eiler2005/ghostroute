#!/bin/sh

# Read-only sing-box outbound evidence snapshot for route diagnostics.
# This script tails logs only. It must not change routing, NAT, sing-box,
# dnsmasq, ipset membership, or Channel A/B/C ownership.
. "$(dirname "$0")/traffic-evidence-lib"

STATE_DIR="${GHOSTROUTE_TRAFFIC_STATE_DIR:-}"
if [ -z "$STATE_DIR" ]; then
  STATE_DIR="/jffs/addons/router_configuration/traffic"
  [ -x /opt/bin/opkg ] && STATE_DIR="/opt/var/log/router_configuration"
fi
LOG_PATH="${SINGBOX_LOG_PATH:-/opt/var/log/sing-box.log}"
EVIDENCE_FILE="$STATE_DIR/sing-box-route-evidence.tsv"
STATUS_FILE="$STATE_DIR/sing-box-route-evidence.status"
LOCK_DIR="$STATE_DIR/sing-box-route-evidence.lock"
MAX_LINES="${GHOSTROUTE_SINGBOX_ROUTE_EVIDENCE_MAX_LINES:-5000}"
MAX_HISTORY="${GHOSTROUTE_SINGBOX_ROUTE_EVIDENCE_MAX_HISTORY:-50000}"

case "$MAX_LINES" in ''|*[!0-9]*) MAX_LINES=5000 ;; esac
case "$MAX_HISTORY" in ''|*[!0-9]*) MAX_HISTORY=50000 ;; esac

mkdir -p "$STATE_DIR"
timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
start_epoch="$(date '+%s')"

status() {
  state="$1"
  reason="$2"
  rows="${3:-0}"
  end_epoch="$(date '+%s')"
  duration_ms=$(( (end_epoch - start_epoch) * 1000 ))
  printf '%s|%s|reason=%s|rows=%s|duration_ms=%s|source=sing-box-log\n' \
    "$timestamp" "$state" "$reason" "$rows" "$duration_ms" > "$STATUS_FILE"
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  status "partial" "lock_busy" 0
  exit 0
fi

TMP_TAIL="/tmp/sing-box-route-evidence.tail.$$"
TMP_ROWS="/tmp/sing-box-route-evidence.rows.$$"
TMP_NEW="/tmp/sing-box-route-evidence.new.$$"
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true; rm -f "$TMP_TAIL" "$TMP_ROWS" "$TMP_NEW"' EXIT

: > "$TMP_ROWS"
read_log() {
  log_path="$1"
  source_role="$2"
  [ -r "$log_path" ] || return 0
  tail -n "$MAX_LINES" "$log_path" > "$TMP_TAIL" 2>/dev/null || : > "$TMP_TAIL"
  awk -v source_role="$source_role" '
  function safe(value) {
    gsub(/[|\r\n]/, "_", value)
    return value
  }
  function conn_id(line,   body, parts) {
    if (match(line, /\[[0-9]+ [^]]+\]/)) {
      body = substr(line, RSTART + 1, RLENGTH - 2)
      split(body, parts, " ")
      return parts[1]
    }
    return ""
  }
  function destination_from_line(line, value) {
    value = line
    sub(/^.* outbound (packet )?connection to /, "", value)
    sub(/[[:space:]].*$/, "", value)
    return value
  }
  function destination_host(value, host) {
    host = value
    if (host ~ /^\[[0-9A-Fa-f:.]+\]:[0-9]+$/) {
      sub(/^\[/, "", host)
      sub(/\]:[0-9]+$/, "", host)
      return host
    }
    sub(/:[0-9]+$/, "", host)
    return host
  }
  function destination_port(value, port) {
    port = value
    if (port ~ /:[0-9]+$/) {
      sub(/^.*:/, "", port)
      return port
    }
    return ""
  }
  function inbound_profile(line, value) {
    if (line !~ /inbound\/[^[]+\[[^]]+\]: \[[^]]+\] inbound (packet )?connection to /) {
      return ""
    }
    value = line
    sub(/^.*inbound\/[^[]+\[[^]]+\]: \[/, "", value)
    sub(/\].*$/, "", value)
    return value
  }
  function inbound_tag(line, value) {
    value = line
    sub(/^.*inbound\/[^[]+\[/, "", value)
    sub(/\].*$/, "", value)
    return value
  }
  function remember_ingress(line, id, tag) {
    id = conn_id(line)
    tag = inbound_tag(line)
    if (id != "") {
      inbound[id] = safe(tag)
      if (inbound_profile(line) != "") profile[id] = safe(inbound_profile(line))
      if (line ~ / inbound (packet )?connection from /) {
        value = line
        sub(/^.* inbound (packet )?connection from /, "", value)
        sub(/[[:space:]].*$/, "", value)
        source_ip[id] = safe(destination_host(value))
      }
    }
  }
  function channel_for(tag, line) {
    if (source_role == "anyT") return "Channel anyT"
    if (source_role == "Snell") return "Channel Snell"
    if (source_role == "Amn") return "Channel Amn"
    if (tag == "reality-in") return "A/Home Reality"
    if (tag ~ /^channel-b-/) return "Channel B"
    if (tag ~ /^channel-c-/) return "Channel C"
    if (tag ~ /^channel-d-/) return "Channel D"
    if (line ~ /inbound\/(redirect|tproxy)\[/) return "Home Wi-Fi/LAN"
    return "Unknown"
  }
  function emit(route, outbound, line, id, destination, host, port, ts) {
    id = conn_id(line)
    destination = safe(destination_from_line(line))
    host = destination_host(destination)
    port = destination_port(destination)
    if (id == "") return
    ts = $1 ~ /^[+-][0-9]+$/ ? $2 "T" $3 $1 : $1
    print ts "|" id "|" route "|" outbound "|" destination "|" host "|" port "|" source_role "|ok|" inbound[id] "|" profile[id] "|" source_ip[id] "|" channel[id] "|" (line ~ / packet connection / ? "udp" : "tcp")
  }
  /sing-box started/ {
    # Connection IDs belong to one process lifetime, never another restart.
    for (key in inbound) delete inbound[key]
    for (key in profile) delete profile[key]
    for (key in source_ip) delete source_ip[key]
    for (key in channel) delete channel[key]
    next
  }
  /inbound\/[^[]+\[[^]]+\]: (\[[^]]+\] )?inbound (packet )?connection (from|to) / {
    remember_ingress($0)
    channel[conn_id($0)] = channel_for(inbound_tag($0), $0)
    next
  }
  /outbound\/vless\[reality-out\]: outbound (packet )?connection to / {
    emit("VPS", "reality-out", $0)
    next
  }
  /outbound\/vless\[sensitive-out\]: outbound (packet )?connection to / {
    emit("VPS", "sensitive-out", $0)
    next
  }
  /outbound\/direct\[direct-out\]: outbound (packet )?connection to / {
    emit("Direct", "direct-out", $0)
    next
  }
' "$TMP_TAIL" >> "$TMP_ROWS"
}

# Separate invocations keep connection IDs scoped to the owning process.
# Reading these logs never enables logging or restarts an engine.
read_log "$LOG_PATH" "sing-box.log"
read_log "${GHOSTROUTE_ANYT_LOG_PATH:-/tmp/ghostroute-anytls/policy.log}" "anyT"
read_log "${GHOSTROUTE_SNELL_LOG_PATH:-/tmp/ghostroute-snell/policy.log}" "Snell"
read_log "${GHOSTROUTE_AMN_LOG_PATH:-/tmp/ghostroute-amn/policy.log}" "Amn"

rows="$(wc -l < "$TMP_ROWS" 2>/dev/null | tr -d ' ')"
case "$rows" in ''|*[!0-9]*) rows=0 ;; esac

if [ "$rows" -gt 0 ]; then
  # Re-reading a quiet log must not fill retention with duplicate observations.
  [ -f "$EVIDENCE_FILE" ] || : > "$EVIDENCE_FILE"
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !seen[$0]++' \
    "$EVIDENCE_FILE" "$TMP_ROWS" > "$TMP_NEW"
  [ ! -s "$TMP_NEW" ] || cat "$TMP_NEW" >> "$EVIDENCE_FILE"
  traffic_evidence_retain "$EVIDENCE_FILE" "$MAX_HISTORY"
  status "ok" "sampled" "$rows"
else
  status "partial" "no_route_evidence" 0
fi
