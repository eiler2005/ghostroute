#!/bin/sh

# Best-effort DNS query/answer sampler for GhostRoute Console.
# This script only reads dnsmasq logs and writes local evidence files.

STATE_DIR="${GHOSTROUTE_TRAFFIC_STATE_DIR:-/jffs/addons/router_configuration/traffic}"
[ -x /opt/bin/opkg ] && STATE_DIR="${GHOSTROUTE_TRAFFIC_STATE_DIR:-/opt/var/log/router_configuration}"

FACTS_FILE="$STATE_DIR/dns-query-facts.tsv"
STATUS_FILE="$STATE_DIR/dns-query-facts.status"
CURSOR_FILE="$STATE_DIR/dns-query-facts.cursor"
MAX_LINES="${GHOSTROUTE_DNS_QUERY_MAX_LINES:-4000}"
LOG_PATH="${GHOSTROUTE_DNSMASQ_LOG:-}"

mkdir -p "$STATE_DIR"

timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
start_epoch="$(date '+%s')"

status() {
  state="$1"
  reason="$2"
  rows="${3:-0}"
  end_epoch="$(date '+%s')"
  duration_ms=$(( (end_epoch - start_epoch) * 1000 ))
  printf '%s|%s|reason=%s|rows=%s|duration_ms=%s|source=dnsmasq\n' \
    "$timestamp" "$state" "$reason" "$rows" "$duration_ms" > "$STATUS_FILE"
}

case "$MAX_LINES" in ''|*[!0-9]*) MAX_LINES=4000 ;; esac

if [ -z "$LOG_PATH" ]; then
  for candidate in /opt/var/log/dnsmasq.log /tmp/syslog.log /var/log/messages; do
    if [ -r "$candidate" ]; then
      LOG_PATH="$candidate"
      break
    fi
  done
fi

if [ -z "$LOG_PATH" ] || [ ! -r "$LOG_PATH" ]; then
  status "partial" "dnsmasq_log_unavailable" 0
  exit 0
fi

TMP_LOG="/tmp/dns-query-snapshot.log.$$"
TMP_FACTS="/tmp/dns-query-snapshot.facts.$$"
LOCK_DIR="/tmp/ghostroute-dns-query-snapshot.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  owner="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
  case "$owner" in ''|*[!0-9]*) ;; *) kill -0 "$owner" 2>/dev/null && exit 0 ;; esac
  rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null || exit 0
  mkdir "$LOCK_DIR" 2>/dev/null || exit 0
fi
echo "$$" > "$LOCK_DIR/pid"
trap 'rm -f "$TMP_LOG" "$TMP_FACTS" "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null' EXIT

# Read an append-only byte range once. Inode/size/prefix changes reset the cursor
# after rotation or truncation; repeated polls must not invent new DNS queries.
inode="$(ls -i "$LOG_PATH" | awk '{print $1}')"
size="$(wc -c < "$LOG_PATH" | tr -d ' ')"
old_inode=0; offset=0; anchor=0
[ -r "$CURSOR_FILE" ] && read -r old_inode offset anchor < "$CURSOR_FILE"
case "$offset" in ''|*[!0-9]*) offset=0 ;; esac
width="$offset"; [ "$width" -gt 64 ] && width=64
current_anchor=0
[ "$width" -gt 0 ] && current_anchor="$(head -c "$width" "$LOG_PATH" | cksum | awk '{print $1}')"
reset=0
if [ "$inode" != "$old_inode" ] || [ "$size" -lt "$offset" ] || [ "$current_anchor" != "$anchor" ]; then offset=0; reset=1; fi
if [ "$reset" = 1 ] && [ "$size" -gt 0 ]; then
  head -c "$size" "$LOG_PATH" | tail -n "$MAX_LINES" > "$TMP_LOG"
  offset=$((size - $(wc -c < "$TMP_LOG" | tr -d ' ')))
elif [ "$size" -gt "$offset" ]; then
  tail -c "+$((offset + 1))" "$LOG_PATH" 2>/dev/null | head -c "$((size - offset))" | head -n "$MAX_LINES" > "$TMP_LOG"
else
  : > "$TMP_LOG"
fi
last_byte="$(tail -c 1 "$TMP_LOG" | od -An -tu1 | tr -d ' ')"
if [ -n "$last_byte" ] && [ "$last_byte" != 10 ]; then
  sed '$d' "$TMP_LOG" > "$TMP_FACTS"; mv "$TMP_FACTS" "$TMP_LOG"
fi
consumed="$(wc -c < "$TMP_LOG" | tr -d ' ')"
offset=$((offset + consumed))
width="$offset"; [ "$width" -gt 64 ] && width=64
anchor=0
[ "$width" -gt 0 ] && anchor="$(head -c "$width" "$LOG_PATH" | cksum | awk '{print $1}')"

awk -v snapshot_ts="$timestamp" -v source_log="$LOG_PATH" '
  BEGIN {
    OFS = "|"
    split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", names, " ")
    for (m = 1; m <= 12; m++) months[names[m]] = m
  }
  function event_time(year, month) {
    precision = "snapshot_approx"
    if ($1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T/) {
      precision = "source_timestamp"
      return $1
    }
    if (($1 in months) && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/) {
      year = substr(snapshot_ts, 1, 4) + 0
      month = months[$1]
      if (month > substr(snapshot_ts, 6, 2) + 0) year--
      precision = "source_seconds"
      return sprintf("%04d-%02d-%02dT%s%s", year, month, $2, $3, substr(snapshot_ts, 20))
    }
    return snapshot_ts
  }
  function clean_domain(value) {
    gsub(/[.;]$/, "", value)
    return value
  }
  function qtype_from_token(value) {
    if (value ~ /^query\[[^]]+\]$/) {
      sub(/^query\[/, "", value)
      sub(/\]$/, "", value)
      return value
    }
    return ""
  }
  {
    rows++
    ts = event_time()
    for (i = 1; i <= NF; i++) {
      qtype = qtype_from_token($i)
      if (qtype != "" && (i + 3) <= NF && $(i + 2) == "from") {
        domain = clean_domain($(i + 1))
        client = $(i + 3)
        last_client[domain] = client
        last_qtype[domain] = qtype
        printf "%s|%s|%s|%s|%s|query|%s|ok|%s\n", ts, client, domain, qtype, "", source_log, precision
      } else if ($i == "reply" && (i + 3) <= NF && $(i + 2) == "is") {
        domain = clean_domain($(i + 1))
        answer = $(i + 3)
        if (answer ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || answer ~ /^[0-9A-Fa-f:]+$/) {
          client = last_client[domain]
          qtype = last_qtype[domain]
          if (qtype == "") qtype = (answer ~ /:/ ? "AAAA" : "A")
          printf "%s|%s|%s|%s|%s|answer|%s|ok|%s\n", ts, client, domain, qtype, answer, source_log, precision
        }
      }
    }
  }
  END {
    if (rows == 0) exit 2
  }
' "$TMP_LOG" > "$TMP_FACTS"

if [ -s "$TMP_FACTS" ]; then
  cat "$TMP_FACTS" >> "$FACTS_FILE"
  tail -n 50000 "$FACTS_FILE" > "$FACTS_FILE.tmp" && mv "$FACTS_FILE.tmp" "$FACTS_FILE"
  rows_written="$(wc -l < "$TMP_FACTS" 2>/dev/null | tr -d ' ')"
  status "ok" "sampled" "${rows_written:-0}"
else
  status "partial" "no_dns_rows" 0
fi
printf '%s %s %s\n' "$inode" "$offset" "$anchor" > "$CURSOR_FILE.tmp"
mv "$CURSOR_FILE.tmp" "$CURSOR_FILE"
[ "$offset" -lt "$size" ] && status "partial" "backlog_pending" "${rows_written:-0}"
exit 0
