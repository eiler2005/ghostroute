#!/bin/sh
# Opt-in boot support for a readable, write-protected Entware volume.
# Service ownership remains with rc.unslung and the runtime supervisor.

CONFIG=${GHOSTROUTE_RO_RECOVERY_CONFIG:-/jffs/ghostroute-recovery/readonly-entware.conf}
STATE=${GHOSTROUTE_RO_RECOVERY_STATE:-/tmp/ghostroute-readonly-entware}
LOCKDIR=${GHOSTROUTE_RO_RECOVERY_LOCK:-/tmp/ghostroute-readonly-entware.lock}
BLOCK_ROOT=/sys/block

log() { logger -t ghostroute-readonly-entware "$*" 2>/dev/null || true; }

load_config() {
  ENABLED=0
  UUID=
  MOUNTPOINT=
  ARCHIVE=/jffs/ghostroute-recovery/entware-etc.tgz
  [ ! -r "$CONFIG" ] || . "$CONFIG"
  [ "$ENABLED" = 1 ] || return 0
  case "$UUID" in ''|*[!a-fA-F0-9-]*) return 1 ;; esac
  case "$MOUNTPOINT" in /tmp/mnt/*) ;; *) return 1 ;; esac
  case "$MOUNTPOINT" in *[!a-zA-Z0-9_./-]*|*/../*|*/..) return 1 ;; esac
}

get_uuid() { blkid "$1" 2>/dev/null | sed -n 's/.* UUID="\([^"]*\)".*/\1/p'; }

mount_record() {
  awk -v p="$MOUNTPOINT" '$2==p {print $1, $3, $4; exit}' /proc/mounts
}

partition_nodes() { printf '%s\n' /dev/sd*[0-9]; }
is_block_device() { [ -b "$1" ]; }

find_device() {
  # Merlin exposes /sys/block but may omit /sys/class/block entirely.
  for partition in $(partition_nodes); do
    is_block_device "$partition" || continue
    [ "$(get_uuid "$partition")" != "$UUID" ] || { printf '%s\n' "$partition"; return 0; }
  done
  return 1
}

device_ro() {
  disk=${1##*/}; disk=$(printf '%s' "$disk" | sed 's/[0-9][0-9]*$//')
  cat "$BLOCK_ROOT/$disk/ro"
}

ram_bound() {
  target=$(readlink -f "/opt/$1") || return 1
  awk -v p="$target" '$2==p && $3=="tmpfs" {found=1} END {exit !found}' /proc/mounts
}

archive_check() {
  [ -s "$ARCHIVE" ] || return 1
  gzip -t "$ARCHIVE" >/dev/null 2>&1 || return 1
  listing="$STATE/archive-list.$$"
  mkdir -p "$STATE" || return 1
  tar -tzf "$ARCHIVE" >"$listing" 2>/dev/null || { rm -f "$listing"; return 1; }
  awk '
    $0 !~ /^etc(\/|$)/ && $0 !~ /^var\/cache\/dnscrypt-proxy(\/|$)/ {bad=1}
    $0 ~ /(^|\/)\.\.(\/|$)/ {bad=1}
    $0 == "etc/sing-box/config.json" {config=1}
    END {exit bad || !config}
  ' "$listing"
  result=$?
  rm -f "$listing"
  return "$result"
}

opt_link_target_ok() {
  case "$1" in /tmp/opt|tmp/opt) return 0 ;; *) return 1 ;; esac
}

ensure_opt_link() {
  if [ ! -e /opt ] && [ -L /opt ] && opt_link_target_ok "$(readlink /opt)" && [ ! -e /tmp/opt ]; then
    ln -snf "$MOUNTPOINT/entware" /tmp/opt || return 1
  fi
  [ "$(readlink -f /opt)" = "$MOUNTPOINT/entware" ]
}

mount_readonly() { mkdir -p "$MOUNTPOINT" && mount -t ext4 -o ro,noload "$1" "$MOUNTPOINT"; }
bind_directory() { mount -o bind "$1" "$2"; }
extract_seed() { mkdir -p "$1" && tar -xzf "$ARCHIVE" -C "$1"; }
targets_present() {
  for rel in etc var/run var/log var/cache/dnscrypt-proxy tmp; do
    [ -d "/opt/$rel" ] || return 1
  done
}
start_entware() {
  [ -x /opt/etc/init.d/rc.unslung ] && /opt/etc/init.d/rc.unslung start >/dev/null 2>&1
}

prepare_inner() {
  [ "$ENABLED" = 1 ] || return 0
  [ -z "${1:-}" ] || [ "$1" = "$MOUNTPOINT" ] || return 0
  record=$(mount_record)
  if [ -n "$record" ]; then
    set -- $record
    [ "$(get_uuid "$1")" = "$UUID" ] || return 0
    [ "$2" = ext4 ] || return 1
    case ",$3," in *,ro,*) ;; *) return 0 ;; esac
  else
    device=
    attempts=0
    while [ "$attempts" -lt 30 ]; do
      device=$(find_device) && break
      attempts=$((attempts + 1))
      sleep 1
    done
    [ -n "$device" ] || { log "configured USB device not found"; return 1; }
    [ "$(device_ro "$device")" = 1 ] || return 0
  fi

  archive_check || { log "recovery archive is missing or invalid"; return 1; }
  # Firmware automount may have completed while we waited for the device.
  if [ -z "$(mount_record)" ]; then
    mount_readonly "$device" || { log "read-only USB mount failed"; return 1; }
    : >"$STATE/start-needed"
  fi
  # Revalidate identity before touching any Entware directory.
  record=$(mount_record); set -- $record
  [ "${2:-}" = ext4 ] && [ "$(get_uuid "${1:-}")" = "$UUID" ] || return 1
  case ",${3:-}," in *,ro,*) ;; *) return 0 ;; esac
  ensure_opt_link || { log "Entware link does not match configured USB"; return 1; }
  targets_present || { log "required Entware directory missing"; return 1; }
  missing=0
  for rel in etc var/run var/log var/cache/dnscrypt-proxy tmp; do
    ram_bound "$rel" || missing=1
  done
  if [ "$missing" = 1 ]; then
    seed="$STATE/seed.$$"
    extract_seed "$seed" || { log "archive extraction failed"; return 1; }
    for rel in etc var/run var/log var/cache/dnscrypt-proxy tmp; do
      ram_bound "$rel" && continue
      mkdir -p "$seed/$rel" || return 1
      chmod 755 "$seed/$rel" || return 1
      bind_directory "$seed/$rel" "/opt/$rel" || { log "RAM bind failed"; return 1; }
    done
    log "read-only Entware RAM directories prepared"
  fi
  return 0
}

snapshot_inner() {
  [ "$ENABLED" = 1 ] || return 0
  record=$(mount_record); set -- $record
  [ -n "${1:-}" ] && [ "$(get_uuid "$1")" = "$UUID" ] || return 0
  ensure_opt_link || return 1
  /opt/bin/sing-box check -c /opt/etc/sing-box/config.json >/dev/null 2>&1 || return 1
  before=$(sha256sum /opt/etc/sing-box/config.json | awk '{print $1}')
  temporary="$ARCHIVE.new.$$"
  tar -czf "$temporary" -C /opt etc var/cache/dnscrypt-proxy || { rm -f "$temporary"; return 1; }
  after=$(sha256sum /opt/etc/sing-box/config.json | awk '{print $1}')
  [ "$before" = "$after" ] || { rm -f "$temporary"; return 1; }
  saved_archive=$ARCHIVE; ARCHIVE=$temporary
  archive_check; result=$?
  ARCHIVE=$saved_archive
  [ "$result" = 0 ] || { rm -f "$temporary"; return 1; }
  chmod 600 "$temporary" && mv -f "$temporary" "$ARCHIVE" || return 1
  sync || return 1
  log "recovery configuration snapshot saved"
  echo snapshot=saved
}

status_inner() {
  printf 'enabled=%s\n' "$ENABLED"
  [ "$ENABLED" = 1 ] || return 0
  archive_check && echo archive=ok || echo archive=invalid
  for rel in etc var/run var/log var/cache/dnscrypt-proxy tmp; do
    ram_bound "$rel" && printf '%s=ram\n' "$rel" || printf '%s=normal\n' "$rel"
  done
}

main() {
  umask 077
  load_config || { log "invalid recovery configuration"; return 1; }
  [ "$ENABLED" = 1 ] || { echo recovery=disabled; return 0; }
  case "${1:-status}" in
    status) status_inner; return ;;
    check) archive_check; return ;;
    prepare|boot|snapshot) ;;
    *) echo "usage: $0 {prepare [mountpoint]|boot|snapshot|check|status}" >&2; return 64 ;;
  esac
  attempts=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    attempts=$((attempts + 1)); [ "$attempts" -lt 45 ] || return 1
    sleep 1
  done
  trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT
  case "$1" in
    snapshot) snapshot_inner ;;
    prepare) prepare_inner "${2:-}" ;;
    boot)
      prepare_inner || return 1
      if [ -f "$STATE/start-needed" ]; then
        start_entware || return 1
        rm -f "$STATE/start-needed"
      fi
      ;;
  esac
}

if [ "${GHOSTROUTE_RO_RECOVERY_LIBRARY_ONLY:-0}" != 1 ]; then main "$@"; fi
